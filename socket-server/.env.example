# Port Socket.IO server ini mendengarkan koneksi.
PORT=4000

# HARUS sama persis dengan JWT_SECRET di .env CodeIgniter 4 (root repo).
# Socket.IO memverifikasi token secara lokal (stateless), sedangkan otorisasi
# per-aksi (membership, dst) tetap divalidasi ulang oleh CI4 lewat REST API.
JWT_SECRET=change-this-must-match-ci4-env

# Base URL REST API CodeIgniter 4 (tanpa trailing slash).
# Contoh lokal (php spark serve): http://localhost:8080/api
# Contoh docker-compose (service nginx di network yang sama): http://nginx/api
CI4_API_BASE_URL=http://localhost:8080/api

# Internal API key untuk service-to-service call Node -> CI4 (lihat InternalAuthFilter).
# HARUS sama persis dengan INTERNAL_API_KEY di .env root (CI4).
INTERNAL_API_KEY=change-this-must-match-ci4-env

# Path ke Firebase service account JSON (generate dari Firebase Console > Project Settings > Service Accounts).
# Contoh: /absolute/path/to/service-account.json atau ./service-account.json (relatif dari socket-server/)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Valkey/Redis for presence & Socket.IO adapter (multi-instance scaling)
# VALKEY_HOST=valkey (service name in docker-compose)
# VALKEY_PORT=6379
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
